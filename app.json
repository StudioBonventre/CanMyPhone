{
  "expo": {
    "name": "CanMyPhone",
    "slug": "canmyphone",
    "version": "0.12.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "canmyphone",
    "plugins": [
      "./plugins/withCanMyPhoneAppIntents",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.studiobonventre.canmyphone.widgets",
          "groupIdentifier": "group.com.studiobonventre.canmyphone",
          "enablePushNotifications": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studiobonventre.canmyphone",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.studiobonventre.canmyphone"
        ]
      },
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSCameraUsageDescription": "CanMyPhone nutzt die Kamera nur, wenn du eine Funktion ausdrücklich startest, die Kamerazugriff benötigt.",
        "NSMicrophoneUsageDescription": "CanMyPhone nutzt das Mikrofon nur, wenn du eine Funktion ausdrücklich startest, die Mikrofonzugriff benötigt.",
        "NSPhotoLibraryUsageDescription": "CanMyPhone greift nur auf deine Fotomediathek zu, wenn du eine Funktion ausdrücklich startest, die Fotos benötigt."
      }
    },
    "android": {
      "package": "com.studiobonventre.canmyphone"
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.studiobonventre.canmyphone.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.studiobonventre.canmyphone"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "be352517-4c42-444d-830e-e68dd8f5bacd"
      }
    },
    "owner": "studiobonventre"
  }
}
