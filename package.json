{
  "name": "canmyphone",
  "version": "0.12.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "dev:ios": "expo start --dev-client",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "build:ios:dev": "eas build --profile development --platform ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run test:unit && npx expo-doctor"
  },
  "dependencies": {
    "@expo/ui": "57.0.19",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.24",
    "expo-blur": "~57.0.3",
    "expo-brightness": "~57.0.2",
    "expo-dev-client": "~57.0.19",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.1",
    "expo-widgets": "57.0.20",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
