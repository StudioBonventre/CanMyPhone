{
  "name": "canmyphone",
  "version": "0.9.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "dev:ios": "expo start --dev-client",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "build:ios:dev": "eas build --profile development --platform ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/ui": "~57.0.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.0",
    "expo-blur": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.1",
    "expo-widgets": "~57.0.8",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  }
}
